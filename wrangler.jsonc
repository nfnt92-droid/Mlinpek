// Cloudflare Workers deploy (Workers Builds: build `npm run build`, deploy `npx wrangler deploy`).
// "name" must match the Worker's name in the Cloudflare dashboard.
{
  "name": "mlinpek",
  "compatibility_date": "2025-09-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // keep variables set in the dashboard (FORM_FROM, FORM_TO, FORM_TO_JOBS) across deploys;
  // RESEND_API_KEY is a secret and survives deploys anyway
  "keep_vars": true
}
